# Optional. Without COR_LLM_MODEL the demo uses the deterministic mock answerer and needs no key.
# Any LiteLLM model string works; set the matching provider key below.
COR_LLM_MODEL=
# COR_LLM_MODEL=anthropic/claude-sonnet-5-5
# COR_LLM_MODEL=openai/gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set to 1 to let the LLM judge entailment instead of lexical overlap.
# Quote matching, citation checks and number/name checks stay deterministic either way.
COR_LLM_JUDGE=0

# Where /ask requests are logged.
# COR_RUNS_LOG=runs.jsonl
